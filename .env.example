# Copy this file to .env (or just export the variable in your shell) and
# fill in your own key. Get one at https://console.anthropic.com/
#
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# The project works without this key too - query.py and eval.py will just
# show retrieved chunks instead of a generated answer.
ANTHROPIC_API_KEY=
